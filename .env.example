# -------------------------------------------------------------------
#           DKP Bot Environment Variables Template
# -------------------------------------------------------------------
#
# This file provides a template for the environment variables required
# to run the DKP Discord Bot. To use it, follow these steps:
#
# 1.  Create a copy of this file in the same directory.
# 2.  Rename the copy to `.env.local`.
# 3.  Fill in the values for each variable as described below.
#
# The bot is configured to automatically load variables from `.env.local`
# if it exists, which prevents your sensitive keys from being tracked
# by Git (since `.env.local` is included in .gitignore).

# --- Discord Bot Configuration ---

# Your Discord bot's authentication token.
# Obtain this from the Discord Developer Portal under your application's
# 'Bot' section. This is a sensitive key and should not be shared.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# --- License Server Configuration ---

# Set this to "false" to disable the license check for local testing or
# if you are running the bot without a licensing server. When disabled,
# the bot will not attempt to contact the license server, and the
# `GUILD_LICENSE_KEY` and `LICENSE_SERVER_URL` variables are not required.
# Defaults to "true" if not set.
LICENSE_CHECK_ENABLED=true

# The license key for your guild. This key is used to validate the bot's
# subscription status with the licensing server. This is only required if
# `LICENSE_CHECK_ENABLED` is set to "true".
GUILD_LICENSE_KEY=YOUR_GUILD_LICENSE_KEY_HERE

# The URL of the licensing server. For local testing, this will typically
# be http://127.0.0.1:5000. This is only required if `LICENSE_CHECK_ENABLED`
# is set to "true".
LICENSE_SERVER_URL=http://127.0.0.1:5000
